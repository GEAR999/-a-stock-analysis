[Unit]
Description=mootdx 行情数据服务（通达信协议）
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mootdx-server
ExecStart=/opt/mootdx-server/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mootdx
Environment=PYTHONUNBUFFERED=1

# 内存限制（防止 OOM）
MemoryMax=512M

# 优雅关闭
KillSignal=SIGTERM
TimeoutStopSec=10s

# 安全加固（可选）
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
